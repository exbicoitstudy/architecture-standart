System_Boundary(it, "IT системы банка"){
    System(deposits, "Каталог депозитов", "Централизованное хранилище и выгрузка ставок")
    System(CallCRM, "Система кол-центра", "Внутренняя CRM банка для обработки звонков")
}

System_Ext(partner_callcenter, "Партнёрский кол-центр", "Внешняя система партнёра")

Rel(deposits, CallCRM, "Передача актуальных ставок")
Rel(CallCRM, callcenter_employee, "Доступ к ставкам по депозитам")

Rel(deposits, partner_callcenter, "Выгрузка и отправка файла ставок (CSV/XLSX)")
Rel(partner_callcenter, partner_callcenter_employee, "Доступ к ставкам из файла")

@enduml
