@startuml
!include ../c4/C4_Context.puml
AddRelTag("dashed", $textColor=$ARROW_FONT_COLOR, $lineColor=$ARROW_COLOR, $lineStyle=DashedLine())

Person(callcenter_employee, "Сотрудник кол-центра", "Работает с системой кол-центра")
